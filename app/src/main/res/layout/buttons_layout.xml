<!-- buttons_layout.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/btns"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    app:layout_constraintEnd_toEndOf="parent"
    app:layout_constraintTop_toTopOf="parent">

    <RadioGroup xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/buttonsRadioGroup"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_weight="1"
        android:gravity="center"
        android:orientation="horizontal">

        <!-- Кнопка 1 -->
        <RadioButton
            android:id="@+id/audioButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/segment_btn_left"
            android:button="@android:color/transparent"
            android:checked="true"
            android:padding="16dp"
            android:text="Аудио"
            android:gravity="center"
            android:layout_weight="0.5"
            android:textColor="@drawable/text_color_selector" />

        <!-- Кнопка 2 -->
        <RadioButton
            android:id="@+id/tafsir"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/segment_btn_right"
            android:button="@android:color/transparent"
            android:padding="16dp"
            android:layout_weight="0.5"
            android:text="Тафсир"
            android:gravity="center"
            android:textColor="@drawable/text_color_selector" />

    </RadioGroup>

    <ImageView
        android:id="@+id/imOpenCloseTafsir"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:padding="20dp"
        android:src="@drawable/open_svg"
        android:layout_gravity="right|top"
        android:scaleType="centerCrop">
    </ImageView>

</LinearLayout>
