<!-- res/layout/popup_bookmark_colors.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:padding="16dp"
    android:background="@drawable/popup_background"
    android:elevation="8dp">

    <!-- Красная закладка -->
    <ImageView
        android:id="@+id/color_red"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_red"
        android:layout_margin="8dp"
        android:contentDescription="Красный" />

    <!-- Черная закладка -->
    <ImageView
        android:id="@+id/color_black"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_black"
        android:layout_margin="8dp"
        android:contentDescription="Черный" />

    <!-- Белая закладка -->
    <ImageView
        android:id="@+id/color_white"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full"
        android:layout_margin="8dp"
        android:contentDescription="Белый" />

    <!-- Зеленая закладка -->
    <ImageView
        android:id="@+id/color_green"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_green"
        android:layout_margin="8dp"
        android:contentDescription="Зеленый" />

    <!-- Фиолетовая закладка -->
    <ImageView
        android:id="@+id/color_fiol"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_fiol"
        android:layout_margin="8dp"
        android:contentDescription="Фиолетовый" />

    <ImageView
        android:id="@+id/color_pink"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_pink"
        android:layout_margin="8dp"
        android:contentDescription="Розовый" />

    <!-- Желтая закладка -->
    <ImageView
        android:id="@+id/color_yellow"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_yellow"
        android:layout_margin="8dp"
        android:contentDescription="Желтый" />

    <!-- Оранжевая закладка -->
    <ImageView
        android:id="@+id/color_orange"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_orange"
        android:layout_margin="8dp"
        android:contentDescription="Оранжевый" />

    <!-- Бирюзовая закладка -->
    <ImageView
        android:id="@+id/color_bir"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_bir"
        android:layout_margin="8dp"
        android:contentDescription="Бирюзовый" />

    <!-- Синяя закладка -->
    <ImageView
        android:id="@+id/color_blue"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bookmark_full_blue"
        android:layout_margin="8dp"
        android:contentDescription="Синий" />

</LinearLayout>