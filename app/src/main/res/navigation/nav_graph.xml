<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/surasFragment">


    <fragment
        android:id="@+id/surasFragment"
        android:name="raf.console.quran7hours.ui.fragments.SurasFragment"
        android:label="Коран аудио"
        tools:layout="@layout/fragment_suras" >
        <action
            android:id="@+id/action_surasFragment_to_appAboutFragment"
            app:destination="@id/appAboutFragment" />
        <action
            android:id="@+id/action_surasFragment_to_fullQuranFragment2"
            app:destination="@id/fullQuranFragment" />
    </fragment>
    <fragment
        android:id="@+id/appAboutFragment"
        android:name="raf.console.quran7hours.ui.fragments.about_app.AppAboutFragment"
        android:label="О приложении"
        tools:layout="@layout/fragment_app_about" >
        <action
            android:id="@+id/action_appAboutFragment_to_surasFragment"
            app:destination="@id/surasFragment" />
        <action
            android:id="@+id/action_appAboutFragment_to_fullQuranFragment2"
            app:destination="@id/fullQuranFragment" />
    </fragment>
    <fragment
        android:id="@+id/fullQuranFragment"
        android:name="raf.console.quran7hours.ui.fragments.FullQuranFragment"
        android:label="fragment_full_quran"
        tools:layout="@layout/fragment_full_quran" >
        <action
            android:id="@+id/action_fullQuranFragment2_to_appAboutFragment"
            app:destination="@id/appAboutFragment" />
        <action
            android:id="@+id/action_fullQuranFragment2_to_surasFragment"
            app:destination="@id/surasFragment" />
    </fragment>

</navigation>